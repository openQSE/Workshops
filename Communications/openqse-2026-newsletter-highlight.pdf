   </rdf:Seq>
  </dc:creator>
  <dc:description>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>July 24, 2026 â€” Group photo at the Open Quantum-HPC Software Ecosystem (openQSE) conference at Oak Ridge National Laboratory. The openQSE initiative brings together leaders from industry, academia, and research to advance an open, modular software ecosystem that enables seamless integration between high-performance computing (HPC) and quantum computing through interoperable, vendor-neutral technologies.</rdf:li>
   </rdf:Alt>
  </dc:description>
  <dc:format>image/jpeg</dc:format>
  <dc:subject>
   <rdf:Bag>
    <rdf:li>DOE</rdf:li>
